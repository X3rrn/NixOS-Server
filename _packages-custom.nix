{config,pkgs,lib,inputs,modulesPath,pkgs-master,chaotic,...}:let unstable=import inputs.nixpkgs-unstable{system="x86_64-linux";config={allowUnfree=true;permittedInsecurePackages=["ventoy-1.1.17" "ventoy-qt5-1.1.17" "pnpm-10.29.2"];};overlays=[(ufinal: uprev:{python314=uprev.python314.override{packageOverrides=pyfinal: pyprev:{python-aodhclient=pyfinal.buildPythonPackage{pname="aodhclient";version="unstable-${inputs.aodhclient-src.shortRev or "latest"}";pyproject=true;src=inputs.aodhclient-src;build-system=[pyfinal.pbr];dependencies=with pyfinal;[pyfinal.cliff pyfinal.keystoneauth1 pyfinal.osc-lib pyfinal.pbr pyfinal.oslo-serialization pyfinal.osprofiler];env={PBR_VERSION="3.99.0";};doCheck=false;dontCheckRuntimeDeps=true;};};};})];};wgToolsPatched=pkgs.wireguard-tools.overrideAttrs(old:{postFixup=(old.postFixup or "")+''for f in $out/bin/wg-quick $out/bin/.wg-quick-wrapped;do if [ -f "$f" ];then ${pkgs.perl}/bin/perl -0777 -pi -e 's/auto_su\(\) \{.*?\n\}/auto_su() { return 0; }/s' "$f";fi;done'';});vpn=pkgs.writeShellScriptBin "vpn-rotate-monitor" "PATH=\"${lib.makeBinPath((with pkgs;[coreutils iputils bash procps openvpn dos2unix gawk gnugrep iproute2 findutils gnused dnsutils nftables systemd curl conntrack-tools util-linux])++[wgToolsPatched])}:$PATH\";${builtins.readFile ./scripts/vpn-rotate-monitor.sh}";nix-deps=pkgs.writeShellScriptBin "nix-deps" ''set -euo pipefail;PATH="${lib.makeBinPath(with pkgs;[binutils-unwrapped gawk])}:$PATH";if [ "$#" -eq 0 ];then echo "usage: nix-deps <path-to-binary>" >&2;exit 1;fi;if [ ! -e "$1" ];then echo "nix-deps: no such file: $1" >&2;exit 1;fi;OUT="$(readelf -d "$1"|awk -f ${./scripts/process_readelf.awk})";if [ -z "$OUT" ];then echo "No RUNPATH/RPATH/NEEDED entries (or no dynamic section at all).";echo "This binary is likely statically linked and should run as-is.";else printf '%s\n' "$OUT";fi'';in{inherit unstable wgToolsPatched vpn nix-deps;}
