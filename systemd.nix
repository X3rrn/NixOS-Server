{flake.modules.nixos.systemd={config,pkgs,lib,inputs,modulesPath,pkgs-master,chaotic,...}:let cp=import ./_packages-custom.nix{inherit config pkgs lib inputs modulesPath pkgs-master chaotic;};inherit (cp) vpn;in{systemd={package=config.boot.kernelPackages.systemd;tmpfiles.rules=["d /var/lib/clamav 0755 clamav clamav -" "d /var/log/clamav 0755 clamav clamav -" "d /run/clamav 0755 clamav clamav -" "d /var/lib/vpn-rotate 0700 root root -"];services={clamav-freshclam={description="ClamAV Freshclam";after=["network.target"];wantedBy=["multi-user.target"];serviceConfig={Type="simple";ExecStart="${pkgs.clamav}/bin/freshclam -d";Restart="on-failure";User="clamav";Group="clamav";ProtectSystem="strict";ProtectHome=true;PrivateTmp=true;NoNewPrivileges=true;ReadWritePaths=["/var/lib/clamav" "/var/log/clamav"];RestrictAddressFamilies=["AF_INET"];IPAddressDeny=["any"];IPAddressAllow=["0.0.0.0/0"];};};clamav-daemon={description="ClamAV Daemon";after=["clamav-freshclam.service"];wantedBy=["multi-user.target"];serviceConfig={Type="simple";ExecStart="${pkgs.clamav}/bin/clamd --foreground=yes";Restart="on-failure";User="clamav";Group="clamav";RuntimeDirectory="clamav";RuntimeDirectoryMode="0755";};};vpn-rotate-monitor={description="VPN Rotate Monitor";after=["network-online.target"];wants=["network-online.target"];wantedBy=["multi-user.target"];startLimitIntervalSec=0;serviceConfig={Type="simple";ExecStart="${vpn}/bin/vpn-rotate-monitor";Restart="always";RestartSec=10;TimeoutStopSec=15;Nice=-5;OOMScoreAdjust=-500;CPUQuota="20%";MemoryMax="256M";TasksMax=16;LimitNPROC=32;RuntimeDirectory="vpn-rotate";StandardOutput="journal";StandardError="journal";PrivateTmp=true;ProtectHome=true;ProtectSystem="strict";ReadWritePaths=["/var/lib/vpn-rotate"];NoNewPrivileges=true;};};};settings.Manager={DefaultLimitNOFILE=2097152;DefaultLimitMEMLOCK="infinity";DefaultTasksMax="infinity";RuntimeWatchdogSec="30s";RebootWatchdogSec="10min";};};};}
